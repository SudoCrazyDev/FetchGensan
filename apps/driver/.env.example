# Driver app. Copy to apps/driver/.env and restart the dev server.
# Only EXPO_PUBLIC_* variables reach the app bundle -- and everything in a
# client bundle is public, so never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
# The number the "Call dispatch" buttons dial. Defaults to the seeded test
# dispatcher, which is not a real phone -- set this before launch.
EXPO_PUBLIC_DISPATCH_PHONE=+639170000004
# From `eas init`. Without it push tokens cannot be issued (see app.config.ts).
EAS_PROJECT_ID=
