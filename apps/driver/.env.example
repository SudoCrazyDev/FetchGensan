# Driver app. Copy to apps/driver/.env and restart the dev server.
# Only EXPO_PUBLIC_* variables reach the app bundle -- and everything in a
# client bundle is public, so never put a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
