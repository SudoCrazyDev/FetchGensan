# ---- Supabase (shared) ----
# Rider & driver apps (Expo) read EXPO_PUBLIC_*; admin (Next.js) reads NEXT_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Maps ----
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
GOOGLE_MAPS_SERVER_KEY=your-server-side-key-for-directions

# ---- Payments (phase 2) ----
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
